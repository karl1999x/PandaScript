barra_intall() {
    comando="$1"
    paquete="$2"
    (
        eval "$comando" >/dev/null 2>&1
    ) &
    pid=$!

    # Muestra la barra de progreso mientras el proceso está en ejecución
    while kill -0 "$pid" >/dev/null 2>&1; do
        echo -ne "  \033[1;36m["  # Color cian para el borde izquierdo
        for ((i = 0; i < 20; i++)); do
            echo -ne "\033[1;34m●"  # Cambia el símbolo a un círculo azul
            sleep 0.08
        done
        echo -ne "\033[1;36m]"  # Color cian para el borde derecho
        sleep 0.5
        echo
        tput cuu1 && tput dl1  # Mueve el cursor hacia arriba y borra la línea
    done

    # Verifica el estado de la instalación
    if dpkg --get-selections | grep -w "$paquete" >/dev/null; then
        ESTATUS="\033[1;32mINSTALADO\033[0m"  # Color verde para instalado
    else
        ESTATUS="\033[1;31mFALLO DE INSTALACION\033[0m"  # Color rojo para fallo
    fi

    echo -ne "  \033[1;36m[\033[1;34m●●●●●●●●●●●●●●●●●●●●●\033[1;36m] $ESTATUS \033[0m\n"
    sleep 0.5
}
