install4() {
    local input="$1"
    local key="$2"
    local output=""

    # Eliminar bytes nulos de la entrada para evitar errores
    input=$(echo -n "$input" | tr -d '\0')

    for ((i=0; i<${#input}; i++)); do
        output+=$(printf "\\$(printf '%03o' "$(( $(printf '%d' "'${input:i:1}") ^ $(printf '%d' "'$key") ))")")
    done

    echo "$output"
}

