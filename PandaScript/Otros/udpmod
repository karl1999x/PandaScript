}


_reiniciar_servicio() {
    if systemctl restart hysteria; then
        echo -e "$(msg -verd 'Servicio Hysteria reiniciado correctamente.')"
        sleep 3
    else
        echo -e "$(msg -verm2 'Error: No se pudo reiniciar el servicio Hysteria.')"
        sleep 3
        return 1
    fi
    
}


_remover_servicio() {
    clear
    msg -bar
    echo -e "$(msg -ama '== Remover Servicio Hysteria ==')"
    msg -bar

   
    echo -e "$(msg -ama 'Deteniendo y deshabilitando el servicio Hysteria...')"
    systemctl stop hysteria 2>/dev/null
    systemctl disable hysteria 2>/dev/null
    if rm -f /etc/systemd/system/hysteria.service && rm -rf /etc/adm-lite/HYSTERIA; then
        echo -e "$(msg -verd 'Servicio Hysteria removido correctamente.')"
    else
        echo -e "$(msg -verm2 'Error: No se pudo remover el servicio Hysteria.')"
        read -p "Presiona Enter para continuar..."
        return 1
    fi
    
    msg -bar
    
    read -p "Presiona Enter para continuar..."
}





