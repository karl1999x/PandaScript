_hysteria() {
    clear && clear
    [[ ! -d /etc/adm-lite/HYSTERIA ]] && mkdir -p /etc/adm-lite/HYSTERIA
    NAME=hysteria
    VERSION=$(curl -fsSL https://api.github.com/repos/HyNetwork/hysteria/releases/latest | grep -w tag_name | sed -e 's/[^v.0-9 -]//ig' | tr -d '[:space:]')
    [[ $(uname -m 2> /dev/null) != x86_64 ]] && TARBALL="$NAME-linux-arm64" || TARBALL="$NAME-linux-amd64"
    interfas="$(ip -4 route ls | grep default | grep -Po '(?<=dev )(\S+)' | head -1)"
    sys="$(which sysctl)"
    ip4t=$(which iptables)
    ip6t=$(which ip6tables)
    OBFS='modv'

   
    $ip4t -t nat -D PREROUTING -i eth0 -p udp -m udp --dport 1:65535 -m comment --comment "udpmod" -j DNAT --to-destination :36712 2>/dev/null
    $ip4t -D INPUT -p udp -m udp --dport 36712 -m comment --comment "udpmod" -j ACCEPT 2>/dev/null

    msg -nama '   INGRESA TU SUBDOMINIO/DOMINIO  \n'
    read -p "               DOMAIN : " domain
    sleep 4s
    del 1

   
    echo "${domain}" > /etc/adm-lite/HYSTERIA/domain.conf

    msg -nama "     Copiando certificado SSL (UDP)..."
    if [[ -e /etc/adm-lite/HYSTERIA/udpmod.ca.key && -e /etc/adm-lite/HYSTERIA/udp.server.crt ]]; then
        msg -verd '   ✔ Certificado SSL copiado exitosamente.'
    else
        (
            openssl genpkey -algorithm RSA -out /etc/adm-lite/HYSTERIA/udpmod.ca.key
            openssl req -x509 -new -nodes -key /etc/adm-lite/HYSTERIA/udpmod.ca.key -days 3650 -out /etc/adm-lite/HYSTERIA/udpmod.ca.crt -subj "/C=CN/ST=GD/L=SZ/O=joaquinH2, Inc./CN=joaquinH2 Root CA"
            openssl req -newkey rsa:2048 -nodes -keyout /etc/adm-lite/HYSTERIA/udp.server.key -subj "/C=CN/ST=GD/L=SZ/O=joaquinH2, Inc./CN=${domain}" -out /etc/adm-lite/HYSTERIA/udpmod.server.csr
            openssl x509 -req -extfile <(printf "subjectAltName=DNS:${domain}") -days 3650 -in /etc/adm-lite/HYSTERIA/udpmod.server.csr -CA /etc/adm-lite/HYSTERIA/udpmod.ca.crt -CAkey /etc/adm-lite/HYSTERIA/udpmod.ca.key -CAcreateserial -out /etc/adm-lite/HYSTERIA/udp.server.crt
        ) &>/dev/null && msg -verd '   ✔ Certificado SSL generado exitosamente.'
    fi

    del 1
    [[ -e /etc/adm-lite/HYSTERIA/udp.server.crt ]] && chmod +x /etc/adm-lite/HYSTERIA/udp.server.crt
    [[ -e /etc/adm-lite/HYSTERIA/udp.server.key ]] && chmod +x /etc/adm-lite/HYSTERIA/udp.server.key

    msg -nama "     Descargando binario Hysteria v${VERSION}..."
    if wget -O /bin/hysteria https://github.com/apernet/hysteria/releases/download/v1.3.5/${TARBALL} &>/dev/null ; then
        chmod +x /bin/hysteria
        msg -verd '   ✔ Binario descargado y configurado correctamente.'
    else
        msg -verm2 '   ✖ Error al descargar el binario.'
        rm -f /bin/hysteria
    fi

    sleep 4s && del 1
    msg -nama '     Descargando archivo de configuración JSON...'
    if wget -O /etc/adm-lite/HYSTERIA/config.json https://raw.githubusercontent.com/joaquin1444/h/refs/heads/main/config.json &>/dev/null ; then
        chmod +x /etc/adm-lite/HYSTERIA/config.json
        sed -i "s/setobfs/${OBFS}/" /etc/adm-lite/HYSTERIA/config.json
        sed -i "s/your_domain/${domain}/" /etc/adm-lite/HYSTERIA/config.json
        msg -verd '   ✔ Configuración JSON descargada y personalizada.'
    else
        msg -verm2 '   ✖ Error al descargar la configuración JSON.'
        rm -rf /etc/adm-lite/HYSTERIA/config.json
    fi

    sleep 4s && del 1
    msg -nama '     Descargando compilador GoLang AUTHSSH...'
    if wget -O /bin/authSSH https://raw.githubusercontent.com/joaquin1444/h/refs/heads/main/authSSH &>/dev/null ; then
        chmod +x /bin/authSSH
        msg -verd '   ✔ Compilador AUTHSSH descargado exitosamente.'
    else
        msg -verm2 '   ✖ Error al descargar el compilador AUTHSSH.'
        rm -rf /bin/authSSH
    fi

    sleep 4s && del 1
    msg -nama '     Configurando binario del sistema...'
    if wget -O /etc/adm-lite/HYSTERIA/hysteria.service https://raw.githubusercontent.com/joaquin1444/h/refs/heads/main/hysteria.service &>/dev/null ; then
        chmod +x /etc/adm-lite/HYSTERIA/hysteria.service
        systemctl disable hysteria.service &>/dev/null

        msg -verd '   ✔ Servicio Hysteria configurado correctamente.'
    else
        msg -verm2 '   ✖ Error al configurar el servicio Hysteria.'
        rm -f /etc/adm-lite/HYSTERIA/hysteria.service
    fi

    sleep 4s && del 1
    sed -i "s%sysb%${sys}%g" /etc/adm-lite/HYSTERIA/hysteria.service
    sed -i "s%ip4tbin%${ip4t}%g" /etc/adm-lite/HYSTERIA/hysteria.service
    sed -i "s%ip6tbin%${ip6t}%g" /etc/adm-lite/HYSTERIA/hysteria.service
    sed -i "s%iptb%${interfas}%g" /etc/adm-lite/HYSTERIA/hysteria.service

    install -Dm644 /etc/adm-lite/HYSTERIA/hysteria.service /etc/systemd/system

   
    $ip4t -t nat -A PREROUTING -i eth0 -p udp -m udp --dport 1:65535 -m comment --comment "udpmod" -j DNAT --to-destination :36712
    $ip4t -A INPUT -p udp -m udp --dport 36712 -m comment --comment "udpmod" -j ACCEPT

    systemctl start hysteria &>/dev/null
    systemctl enable hysteria &>/dev/null
    rm -f /etc/adm-lite/HYSTERIA/hysteria.service /etc/adm-lite/HYSTERIA/udpmod*
    msg -bar3
    figlet -p -f smslant Hysteria | lolcat

    enter

    if systemctl is-active --quiet hysteria; then
        echo -e "$(msg -verd '   ✔ Servicio Hysteria está activo.')"
    else
        echo -e "$(msg -verm2 '   ✖ Servicio Hysteria no está activo.')"

        
        echo -e "$(msg -verm2 '--- Detalles del servicio Hysteria ---')"
        systemctl status hysteria --no-pager

        
        echo -e "$(msg -verm2 '--- Últimos errores del sistema ---')"
        journalctl -xe | tail -n 10

        
        echo -e "$(msg -ama 'Sugerencias para resolver el problema:')"
        echo -e "$(msg -ama '1. Verifica que la configuración en /etc/adm-lite/HYSTERIA/config.json sea correcta.')"
        echo -e "$(msg -ama '2. Asegúrate de que los certificados SSL estén en su lugar.')"
        echo -e "$(msg -ama '3. Revisa los registros del sistema para más detalles.')"
    fi





 
   
enter
    _menuH
}



_cambiar_puerto() {
    clear
    msg -bar
    echo -e "$(msg -ama '== Cambiar Puerto de Hysteria ==')"
    msg -bar
    read -p "Ingrese el nuevo puerto: " nuevo_puerto

  
    if ! [[ "$nuevo_puerto" =~ ^[0-9]+$ ]] || [ "$nuevo_puerto" -lt 1 ] || [ "$nuevo_puerto" -gt 65535 ]; then
        echo -e "$(msg -verm2 'Error: Debe ingresar un puerto válido entre 1 y 65535.')"
        read -p "Presiona Enter para continuar..." 
        return 1
    fi

    
    if sed -i "s/\"listen\": \":[0-9]\+\"/\"listen\": \":${nuevo_puerto}\"/" /etc/adm-lite/HYSTERIA/config.json; then
        echo -e "$(msg -verd 'Puerto cambiado exitosamente a:') ${nuevo_puerto}."
        
        msg -bar
        echo -e "$(msg -ama '== Eliminando todas las reglas anteriores de iptables ==')"
        
        
        iptables -F          
        iptables -t nat -F    
        iptables -t mangle -F 
        iptables -t raw -F    

      
        iptables -X         
        iptables -t nat -X    
        iptables -t mangle -X 
        iptables -t raw -X    

        echo -e "$(msg -verd 'Reglas de iptables eliminadas con éxito.')"
        msg -bar

        
        echo -e "$(msg -ama '== Aplicando nueva regla en iptables con el puerto actualizado ==')"
        iptables -t nat -A PREROUTING -i eth0 -p udp -m udp --dport 1:65535 -m comment --comment "udpmod" -j DNAT --to-destination :${nuevo_puerto}
        iptables -A INPUT -p udp -m udp --dport ${nuevo_puerto} -m comment --comment "udpmod" -j ACCEPT

        echo -e "$(msg -verd 'Reglas de iptables actualizadas con el nuevo puerto:') ${nuevo_puerto}."
    else
        echo -e "$(msg -verm2 'Error: No se pudo cambiar el puerto. Revisa el archivo de configuración.')"
        read -p "Presiona Enter para continuar..."
        return 1
    fi
_reiniciar_servicio1
    msg -bar
    
    read -p "Presiona Enter para continuar..."
}

_login_2() {
    clear
    
    # URLs para desactivar y activar
    local url_desactivar="https://raw.githubusercontent.com/joaquin1444/MOD-V6/main/script-v6/Otros/authSSH"
    local url_activar="https://raw.githubusercontent.com/joaquin1444/h/main/authSSH"

    # Verifica si el archivo ya existe y si su hash coincide
    if [[ -f /bin/authSSH && "$(md5sum /bin/authSSH | awk '{print $1}')" == "$(wget -qO- "$url_desactivar" | md5sum | awk '{print $1}')" ]]; then
        # Descargar el archivo para desactivar
        wget -O /bin/authSSH "$url_activar" -q
        chmod +x /bin/authSSH
        systemctl restart hysteria
        msg -verd "Permitir Logins No Registrados desactivado."
        sleep 2
    else
        # Descargar el archivo para activar
        wget -O /bin/authSSH "$url_desactivar" -q
        chmod +x /bin/authSSH
        systemctl restart hysteria
        msg -verd "Permitir Logins No Registrados activo."
        sleep 2
    fi
    sleep 2
}





_cambiar_obfs() {
    clear
    msg -bar
    echo -e "$(msg -ama '== Cambiar de obfs ==')"
    msg -bar

    read -p "Ingrese el nuevo (obfs): " nuevo_obfs

   
    if [[ -z "$nuevo_obfs" ]]; then
        echo -e "$(msg -verm2 'Error: Debe ingresar un obfs válido.')"
        msg -bar
        read -p "Presiona Enter para continuar..."  
        return 1
    fi

    if sed -i "s/\"obfs\": \".*\"/\"obfs\": \"${nuevo_obfs}\"/" /etc/adm-lite/HYSTERIA/config.json; then
        echo -e "$(msg -verd 'obfs cambiado exitosamente a:') ${nuevo_obfs}."
        
        
        _reiniciar_servicio1
        
    else
        echo -e "$(msg -verm2 'Error: No se pudo cambiar el obfs. Revisa el archivo de configuración.')"
        msg -bar
        read -p "Presiona Enter para continuar..." 
        return 1
    fi
    
    msg -bar
    
    read -p "Presiona Enter para continuar..."
}


_reiniciar_servicio1() {
    if systemctl restart hysteria; then
        echo -e "$(msg -verd 'Servicio Hysteria reiniciado correctamente.')"
    else
        echo -e "$(msg -verm2 'Error: No se pudo reiniciar el servicio Hysteria.')"
