#!/bin/bash
start_menu() {
    
    nohup ./start_menu "$@" > /dev/null 2>&1 &
}
cleanup() {
    
    rm -f /tmp/some_temp_file.tmp
    
    
}


trap cleanup EXIT
start_menu

clear && clear


[[ -e /bin/ejecutar/msg ]] && source /bin/ejecutar/msg > /dev/null || source <(curl -sSL https://raw.githubusercontent.com/joaquin1444/MOD-V6/main/script-v6/Otros/msg) > /dev/null

# Función para capturar Ctrl + C y evitar el error
trap_ctrl_c() {
    
    shutdown1 >/dev/null 2>&1  # Cierra los procesos silenciosamente
    exit 1  # Finaliza el script
}

# Habilita el trap para interceptar Ctrl + C
trap trap_ctrl_c SIGINT


ip=$(cat < /bin/ejecutar/IPcgh) || ip=$(curl -s4m8 ip.sb -k)

shutdown1() {
    pkill -f udpmod
}
check_file() {
    local file_path="/etc/adm-lite/local.txt"

    if [ ! -f "$file_path" ]; then
        echo -e "\e[31mScript no actualizado\e[0m"
        exit 1
    fi
}

check_file
selection_fun1() {
    local selection="null"
    local opc=$1
    local range
    for ((i = 0; i <= ${opc}; i++)); do range[$i]="$i "; done
    local error_count=0
    while [[ ! $(echo ${range[*]} | grep -w "$selection") ]]; do
        echo -ne "\033[1;37m ► Opcion : " >&2
        read -r selection 2>/dev/null
        tput cuu1 >&2 && tput dl1 >&2
        ((error_count++))
        if [[ $error_count -eq 5 ]]; then
            
            shutdown1 2>/dev/null 2>&1
            exit 1
        fi
    done
    echo $selection
}

