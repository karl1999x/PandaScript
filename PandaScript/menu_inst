tcp_BBR () {
    clear
    msg -bar 
    echo -e "\033[1;33m Este Script fue proyectado"
    echo -e "\033[1;33m Para Mejorar La Latencia"
    echo -e "\033[1;33m y velocidad del servidor!"
    msg -bar 
    echo -e "\033[1;32mAnalizando configuración..."
    sleep 1s
    
    # Comprobación de existencia de configuración (#ADM)
    if [[ $(grep -c "^#ADM BBR START" /etc/sysctl.conf) -eq 0 ]]; then
        
        # --- SECCIÓN INSTALAR ---
        
        # 1. Verificar si el kernel soporta BBR (kernel 4.9+)
        if ! modprobe tcp_bbr 2>/dev/null; then
            echo -e "\033[0;31m Error: Su kernel actual ($(uname -r)) no soporta TCP BBR."
            echo -e "\033[0;31m Se requiere un kernel 4.9 o superior. Abortando instalación."
            msg -bar
            read -p "Presiona Enter para continuar..." r
            return
        fi

        echo -e "\033[1;37m Configuración de red (BBR) disponible."
        echo -e "\033[1;37m Este script cambiará configuraciones para reducir la latencia."
        msg -bar 
        read -p " Continuar con la instalación? [s/n]: " -e -i s resp_osta
        echo -e "\033[1;37m"
        
        if [[ "$resp_osta" = 's' ]]; then
            unset resp_osta
            
            # Bloque de configuración, marcado claramente para su futura eliminación
            echo "#ADM BBR START" >> /etc/sysctl.conf
            echo "net.ipv4.tcp_window_scaling = 1
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216
net.ipv4.tcp_rmem = 4096 87380 16777216
net.ipv4.tcp_wmem = 4096 16384 16777216
net.ipv4.tcp_low_latency = 1
net.ipv4.tcp_slow_start_after_idle = 0
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr" >> /etc/sysctl.conf
            echo "#ADM BBR END" >> /etc/sysctl.conf
            
            sysctl -p /etc/sysctl.conf > /dev/null 2>&1
            echo -e "\033[1;32m Configuración de red TCP (BBR) agregada con éxito."
            
            msg -bar 
            read -p "Presiona Enter para continuar..." r
            return
        else
            msg -bar 
            read -p "Presiona Enter para continuar..." r
            return
        fi
        
    else
        # --- SECCIÓN ELIMINAR ---
        
        echo -e "\033[1;33m Configuración de red TCP (BBR) ya está activa en el sistema."
        msg -bar
        read -p " Desea quitar la configuración TCP? [s/n]: " -e -i n res_posta
        
        if [[ "$res_posta" = 's' ]]; then
            unset res_posta
            
            # Eliminación robusta: usa sed para borrar el bloque delimitado
            sed -i '/^#ADM BBR START$/,/^#ADM BBR END$/d' /etc/sysctl.conf
            
            sysctl -p /etc/sysctl.conf > /dev/null 2>&1
            echo -e "\033[1;32m Configuración de red TCP eliminada con éxito."
            
            msg -bar
            read -p "Presiona Enter para continuar..." r
            return
        else
            msg -bar 
            read -p "Presiona Enter para continuar..." r
            return
        fi
    fi
}

