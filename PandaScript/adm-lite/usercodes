function criarusuarioteste(){
    # --- Limpieza de pantalla y encabezado ---
    clear
    for i in {1..20}; do tput cuu1 && tput dl1; done
    meu_ip
    msg -bar
    echo -e "${cor[4]}         CREAR USUARIO SSH TEMPORAL"
    msg -bar

    # --- 1. PIDE DATOS DE FORMA INTERACTIVA ---
    echo -e "${cor[5]} Ingrese el nombre del Usuario:"
    echo -e -n "\033[33m-> \033[0m"
    read -e nome

    if [[ -z "$nome" ]]; then msg -verm "⚠️ Nombre de usuario no puede estar vacío."; return; fi
    if [[ "$nome" =~ [^a-zA-Z0-9] ]]; then msg -verm "⚠️ Nombre de usuario solo puede contener letras y números."; return; fi
    if id "$nome" &>/dev/null; then msg -verm "⚠️ El usuario '$nome' ya existe en el sistema."; return; fi

    echo -e "${cor[5]} Ingrese la contraseña para el usuario '$nome'"
    read -p "Contraseña: " pass
    if [[ -z "$pass" ]]; then msg -verm "⚠️ La contraseña no puede estar vacía."; return; fi
    
    echo -e "${cor[5]} Duración para el Usuario '$nome'"
    echo -e "${cor[3]}   Use: m > minutos, h > horas, d > dias (Ej: 30m, 2h, 1d)"
    read -p "VALIDEZ: " tempoin

    echo -e "${cor[5]} Límite de conexiones para '$nome'"
    read -p "LIMITE (Default: 1): " limit
    [[ -z "$limit" ]] && limit="1"
    
    # --- 2. Lógica de tiempo unificada ---
    local tiempo_en_segundos=0; local tiempo_validez_display
    local unidad=${tempoin: -1}; local cantidad=${tempoin%?}
    if ! [[ "$cantidad" =~ ^[0-9]+$ ]]; then msg -verm "⚠️ Formato de validez incorrecto."; return; fi
    case "$unidad" in
        m) tiempo_en_segundos=$((cantidad * 60)); tiempo_validez_display="$cantidad minutos" ;;
        h) tiempo_en_segundos=$((cantidad * 3600)); tiempo_validez_display="$cantidad horas" ;;
        d) tiempo_en_segundos=$((cantidad * 86400)); tiempo_validez_display="$cantidad días" ;;
        *) msg -verm "⚠️ Unidad de tiempo no válida."; return ;;
    esac

    # --- INICIO DE LA CORRECCIÓN: Expiración de Seguridad a +2 Días ---
    
    # La eliminación real sigue basándose en el tiempo exacto que ingresaste
    local expiration_ts=$(( $(date +%s) + tiempo_en_segundos ))
    
    # La fecha para el sistema ahora se calcula como "hoy + 2 días"
    local valides_para_sistema=$(date -d "now + 2 days" '+%Y-%m-%d')
    
    # --- FIN DE LA CORRECCIÓN ---

    # --- CREACIÓN DEL USUARIO CON VERIFICACIÓN ---
    useradd -M -N -s /bin/false "$nome" -e "$valides_para_sistema"
    
    if [ $? -eq 0 ]; then
        set_passwd "$nome" "$pass"
        
        # Guardado de Datos
        local dir_user="/etc/adm-lite/userDIR"; [[ ! -d "$dir_user" ]] && mkdir -p "$dir_user"
        local user_file="$dir_user/$nome"
        echo "senha: $pass" > "$user_file"; echo "limite: $limit" >> "$user_file"; echo "data: $valides_para_sistema" >> "$user_file"; echo "tipo: ssh temporal" >> "$user_file"

        # Programación de la Eliminación con Desconexión Forzada
        if ! command -v at &>/dev/null; then apt-get install -y at &>/dev/null; fi
        if ! systemctl is-active --quiet atd; then systemctl enable atd &>/dev/null; systemctl start atd &>/dev/null; fi
        local deletion_time_str=$(date -d "@$expiration_ts" '+%H:%M %Y-%m-%d')
        local cleanup_command="pkill -9 -u '$nome' &>/dev/null; /usr/sbin/userdel --force -r '$nome' &>/dev/null; /bin/rm -f '$user_file' &>/dev/null"
        
        if at_output=$(echo "$cleanup_command" | at "$deletion_time_str" 2>&1); then
            msg -verd "Tarea de eliminación automática programada con éxito."
        else
            msg -verm "¡ERROR! No se pudo programar la eliminación."
            msg -ama "Respuesta del sistema 'at': $at_output"
        fi

        # Mensaje de éxito final
        clear
        msg -bar
        echo -e "${cor[2]}   ✓ USUARIO TEMPORAL CREADO CON ÉXITO ✓"
        msg -bar
        echo -e "${cor[5]} USUARIO         : ${cor[4]}$nome"
        echo -e "${cor[5]} PASSWD          : ${cor[4]}$pass"
        echo -e "${cor[5]} LIMITE          : ${cor[4]}$limit"
        echo -e "${cor[5]} VALIDEZ         : ${cor[4]}$tiempo_validez_display"
        echo -e "${cor[5]} EXPIRA Y SE BORRA EL: ${cor[4]}$(date -d "@$expiration_ts" '+%d/%m/%Y a las %H:%M:%S')"
        msg -bar

    else
        msg -verm "¡ERROR GRAVE! No se pudo crear el usuario '$nome' en el sistema."
    fi
    return
}

