block_user () {
    for i in {1..20}; do tput cuu1 && tput dl1; done

    msg -bar
    echo -e "${cor[4]} LOCK / UNLOCK USUARIO PRIVADO "
    msg -bar  
    unset select_name namer nameFX
    select_users 'LOCK / UNLOCK USUARIO PRIVADO'
    [[ -z $select_name ]] && return
    namer="$select_name"

    file_path="/etc/adm-lite/userDIR/$namer"
    [[ ! -d /etc/adm-lite ]] && mkdir -p /etc/adm-lite
    touch /etc/adm-lite/bloqueados

    if [[ -f "$file_path" ]]; then
        local lmt senha
        lmt=$(grep "limite" "$file_path" | awk '{print $2}')
        senha=$(grep "senha" "$file_path" | awk '{print $2}')
        if [[ "$lmt" = "HWID" || "$lmt" = "TOKEN" ]]; then
            nameFX="${senha:-$namer}"
        else
            nameFX=$namer
        fi
    else
        echo "$namer" >> usuarios_no_encontrados.txt
        return  
    fi

    echo -e "${cor[5]} VERIFICANDO ESTADO DE $nameFX "
    msg -bar

    if [[ $(passwd --status $namer | cut -d ' ' -f2) = "P" ]]; then
        echo -e "${cor[5]}Bloqueando USER "
        pkill -u $namer &>/dev/null
        droplim=$(dropbear_pids | grep -w "$namer" | awk '{print $2}')
        kill -9 $droplim &>/dev/null
        usermod -L $namer &>/dev/null
        sleep 2
        msg -verm2 "  ⚠️ LOCK ⚠️"
        
        # Registrar usuario en lista de bloqueados
        grep -qxF "$namer" /etc/adm-lite/bloqueados || echo "$namer" >> /etc/adm-lite/bloqueados
    else
        if [[ -z $(passwd --status $namer | cut -d ' ' -f3) ]]; then
            echo "$namer:default_password" | chpasswd
            echo -e "${cor[5]} Se estableció una contraseña predeterminada para desbloquear al usuario."
        fi
        usermod -U $namer &>/dev/null
        sleep 2
        msg -verd " ⚠️ UNLOCK ⚠️ "
        
        # Eliminar de la lista de bloqueados
        sed -i "/^$namer$/d" /etc/adm-lite/bloqueados
    fi

    pkill -u $namer 2>/dev/null
    kill -9 $(ps aux | grep -vi "[a-z]$namer" | grep -vi "$namer[a-z]" | grep -v "[1-9]$namer" | grep -v "$namer[1-9]" | grep $namer | awk '{print $2}') 2>/dev/null

    return
}











function buscar_usuario() {
    # --- Limpieza de pantalla inicial ---
    clear
    for i in {1..21}; do
        tput cuu1 && tput dl1
    done
    msg -bar
    echo -e "\033[0;33m🔍 BUSCAR USUARIO 🔍\033[0m"
    msg -bar

    # Petición de entrada al usuario
    echo -e -n "\033[1;33mIngrese el nombre de usuario, TOKEN o HWID completo: \033[0m"
    echo
    echo -e -n "\033[33m-> \033[0m"
    read buscar

    if [ -z "$buscar" ]; then
        echo -e "\033[1;31mNo se ingresó ningún valor. Regresando al menú...\033[0m"
        sleep 1
        return
    fi

    echo -e "${cor[4]}Resultados de búsqueda para: $buscar"
    msg -bar
    found=false

    # --- Optimización: Obtenemos los logs UNA SOLA VEZ ---
    journalctl -u dropbear --no-pager --since "1 day ago" | grep "Password auth succeeded" > /tmp/dropbear_logins.log
    ps -eo pid=,lstart=,comm= | grep 'dropbear' > /tmp/active_dropbear.log

    # Bucle principal que recorre los archivos de usuario
    for namer in $(ls "$dir_user" 2>/dev/null); do
        user_file="$dir_user/$namer"
        
        if [ ! -e "$user_file" ] || ! id -u "$namer" &>/dev/null; then
            continue
        fi

        # Leemos el campo 'tipo' primero. Si no existe, leemos 'limite'.
        local tipo_usuario=$(grep "tipo:" "$user_file" 2>/dev/null | awk -F': ' '{print $2}')
        if [[ -z "$tipo_usuario" ]]; then
            tipo_usuario=$(grep "limite:" "$user_file" 2>/dev/null | awk '{print $2}')
        fi
        
        local _sen=$(grep "senha:" "$user_file" 2>/dev/null | awk -F': ' '{print $2}')
        local _limit=$(grep "limite:" "$user_file" 2>/dev/null | awk '{print $2}')
        local valid_date=$(grep "data:" "$user_file" 2>/dev/null | awk -F': ' '{print $2}')
        local creation_date=$(stat -c %y "$user_file" | cut -d' ' -f1)
        
        # Cálculo de días restantes (para todos los tipos, excepto los que no tienen fecha)
        local dias_restantes_calc=0
        if [[ -n "$valid_date" ]]; then
            local valid_timestamp=$(date -d "$valid_date" +%s 2>/dev/null || echo 0)
            dias_restantes_calc=$(( ( valid_timestamp - $(date +%s) ) / 86400 ))
            [ "$dias_restantes_calc" -lt 0 ] && dias_restantes_calc=0
        fi
        local remaining_time_display="${dias_restantes_calc} días"
        
        # --- INICIO DE CÁLCULO DE CONEXIONES Y TIEMPO (CORREGIDO) ---
        local uid=$(id -u "$namer" 2>/dev/null)
        local sqd=0
        local drop=0
        local ovp=0
        local timerr="00:00:00"
        local _oldest_time_s=9999999999
        local _data_now=$(date +%s)

        # 1. Contar conexiones OpenVPN (sin cambios)
        ovp=$(grep -cE ",$namer," /etc/openvpn/openvpn-status.log 2>/dev/null || echo 0)

        # 2. Contar conexiones SSHD (usando el método 'ps' original, que funciona para sshd)
        while read -r _pid _ppid; do
            if [[ -z "$_pid" || -z "$_ppid" ]]; then continue; fi
            local _pname=$(ps -p "$_ppid" -o comm= 2>/dev/null)

            if [[ "$_pname" == *"sshd"* ]]; then
                let sqd++
                local _lstart_str=$(ps -p "$_pid" -o lstart= 2>/dev/null)
                if [[ -n "$_lstart_str" ]]; then
                    local _login_time_s=$(date -d "$_lstart_str" +%s 2>/dev/null)
                    if [[ -n "$_login_time_s" && "$_login_time_s" -lt "$_oldest_time_s" ]]; then
                        _oldest_time_s=$_login_time_s
                    fi
                fi
            fi
        done < <(ps -u "$uid" --no-headers -o pid=,ppid= 2>/dev/null | grep -v "ps -u")

        # 3. Contar conexiones Dropbear (MÉTODO HÍBRIDO)
        grep "for '$namer'" /tmp/dropbear_logins.log > /tmp/user_logins.log
        
        while read -r log_line; do
            local _pid=$(echo "$log_line" | grep -o '\[[0-9]*\]' | tr -d '[]' | head -n 1)
            if [[ -z "$_pid" ]]; then continue; fi
            
            local _lstart_str_full=$(grep "^ *$_pid" /tmp/active_dropbear.log | awk '{$1=$NF=""; print $0}' | xargs)

            if [[ -n "$_lstart_str_full" ]]; then
                let drop++
                local _login_time_s=$(date -d "$_lstart_str_full" +%s 2>/dev/null)
                if [[ -n "$_login_time_s" && "$_login_time_s" -lt "$_oldest_time_s" ]]; then
                    _oldest_time_s=$_login_time_s
                fi
            fi
        done < /tmp/user_logins.log

        # 4. Calcular tiempo para OpenVPN
        if [[ $ovp -gt 0 ]]; then
            local _login_time_s_ovpn=$(grep -w "$namer" /etc/openvpn/openvpn-status.log | head -n 1 | awk -F',' '{print $8}' 2>/dev/null)
            if [[ -n "$_login_time_s_ovpn" && "$_login_time_s_ovpn" -lt "$_oldest_time_s" ]]; then
                 _oldest_time_s=$_login_time_s_ovpn
            fi
        fi

        # 5. Calcular el string de tiempo (HH:MM:SS) de la sesión más antigua
        if [[ "$_oldest_time_s" -lt 9999999999 ]]; then
            local seg=$(($_data_now - $_oldest_time_s))
            local min=$(($seg/60))
            seg=$(($seg-$min*60))
            local hor=$(($min/60))
            min=$(($min-$hor*60))
            timerr=$(printf "%02d:%02d:%02d" $hor $min $seg)
        fi

        # 6. Calcular conexiones totales
        local conexiones=$(($sqd + $drop + $ovp))
        # --- FIN DE CÁLCULO DE CONEXIONES Y TIEMPO ---

        # Comprobar si el usuario coincide con la búsqueda
        if [[ "$namer" == "$buscar" || "$_sen" == "$buscar" ]]; then
            found=true
            clear
            msg -bar
            echo -e "\033[0;33m🔍 Resultados para: $buscar 🔍\033[0m"
            msg -bar

            case "$tipo_usuario" in
                "TOKEN"|"HWID")
                    echo -e "\033[0;33m💻 Tipo: $tipo_usuario\033[0m"
                    echo -e "\033[0;36m👤 Usuario: $_sen\033[0m"
                    echo -e "\033[0;36m🔑 $tipo_usuario: $namer\033[0m"
                    # --- INICIO DE LA CORRECCIÓN: Se añaden los detalles que faltaban ---
                    echo -e "\033[0;33m💻 Límite: $(cat /bin/ejecutar/limFIX 2>/dev/null || echo "1")"
                    echo -e "\033[1;34m📅 Creado: $creation_date\033[0m"
                    echo -e "\033[1;36m⏳ Tiempo restante: $remaining_time_display\033[0m"
                    echo -e "\033[1;36m📅 Fecha de Expiración: $(date -d "$valid_date - 1 day" +%Y-%m-%d)\033[0m"
                    # --- FIN DE LA CORRECCIÓN ---
                    echo -e "\033[1;32m🟢 Conexiones:  $conexiones\033[0m"
                    echo -e "\033[0;36m⏱️ Tiempo conectado: $timerr\033[0m"
                    msg -bar
                    ;;
                "ssh temporal")
                    echo -e "\033[0;33m💻 Tipo: SSH TEMPORAL\033[0m"
                    echo -e "\033[0;36m👤 Usuario: $namer\033[0m"
                    echo -e "\033[0;36m🔑 Contraseña: $_sen\033[0m"
                    echo -e "\033[0;33m💻 Límite: $_limit\033[0m"
                    echo -e "\033[1;32m🟢 Conexiones:  $conexiones\033[0m"
                    echo -e "\033[0;36m⏱️ Tiempo conectado: $timerr\033[0m"
                    msg -bar
                    ;;
                *) # Default para SSH Normal
                    echo -e "\033[0;33m💻 Tipo: SSH NORMAL\033[0m"
                    echo -e "\033[0;36m👤 Usuario: $namer\033[0m"
                    echo -e "\033[0;36m🔑 Contraseña: $_sen\033[0m"
                    echo -e "\033[0;33m💻 Límite: $_limit\033[0m"
                    echo -e "\033[1;34m🗓️ Creado: $creation_date\033[0m"
                    echo -e "\033[1;36m⏳ Tiempo restante: $remaining_time_display\033[0m"
                    echo -e "\033[1;36m📅 Fecha de Expiración: $(date -d "$valid_date - 1 day" +%Y-%m-%d)\033[0m"
                    echo -e "\033[1;32m🟢 Conexiones:  $conexiones\033[0m"
                    echo -e "\033[0;36m⏱️ Tiempo conectado: $timerr\033[0m"
                    msg -bar
                    ;;
            esac
        fi
    done

    if [ "$found" == "false" ]; then
        echo -e "\033[1;31m❌ No se encontró ningún usuario con los criterios especificados.\033[0m"
        msg -bar
    fi

    # --- Limpieza de archivos temporales ---
    rm /tmp/dropbear_logins.log
    rm /tmp/active_dropbear.log
    rm /tmp/user_logins.log &>/dev/null

    return
}















































