monitoreo_en_vivo() {
    local refresh=10
    local factor=2.11          # ← ¡AJUSTADO EXACTAMENTE PARA TU CASO!

    trap "break" INT
    echo -e "${cor[3]}Iniciando monitoreo SSH - CONSUMO ESTIMADO CELULAR...${reset}"

    while true; do
        clear
        echo -e "${cor[2]}====================================================${reset}"
        echo -e "${cor[3]}  MONITOR SSH - CONSUMO ESTIMADO CELULAR - $(date '+%H:%M:%S') [80→22]${reset}"
        echo -e "${cor[2]}====================================================${reset}"
        echo -e "${cor[4]}USUARIO     | CONSUMO CELULAR  | TIEMPO${reset}"
        echo -e "${cor[2]}----------------------------------------------------${reset}"

        local count=0

        while IFS= read -r line; do
            [[ -z "$line" ]] && continue

            read -r pid user etime <<< "$line"

            # Tráfico total bruto
            local total_bytes=0
            if [[ -r "/proc/$pid/io" ]]; then
                r=$(awk '/rchar:/{print $2}' "/proc/$pid/io" 2>/dev/null || echo 0)
                w=$(awk '/wchar:/{print $2}' "/proc/$pid/io" 2>/dev/null || echo 0)
                total_bytes=$((r + w))
            fi

            # Corrección para celular
            local estimated=$(awk -v t="$total_bytes" -v f="$factor" 'BEGIN {printf "%d", t / f}')

            # Formato MB/GB
            local consumo
            if (( estimated >= 1073741824 )); then
                consumo=$(awk -v b=$estimated 'BEGIN {printf "%.2f GB", b/1073741824}')
            elif (( estimated >= 1048576 )); then
                consumo=$(awk -v b=$estimated 'BEGIN {printf "%.2f MB", b/1048576}')
            else
                consumo=$(awk -v b=$estimated 'BEGIN {printf "%.2f KB", b/1024}')
            fi

            # Tiempo preciso
            local time_fmt=$(echo "$etime" | awk -F'[-:]' '
            {
                if (NF==4) printf "%dd %02dh %02dm %02ds", $1,$2,$3,$4
                else if (NF==3) printf "%02dh %02dm %02ds", $1,$2,$3
                else if (NF==2) printf "%02dm %02ds", $1,$2
                else printf "%ds", $1
            }')

            printf "${cor[1]}%-11s${reset} | %-16s | %s\n" \
                "$user" "$consumo" "$time_fmt"

            ((count++))
        done < <(ps -eo pid,user,etime,command | grep '[s]shd:' | grep -v root | awk '{print $1 " " $2 " " $3}')

        [[ $count -eq 0 ]] && echo -e "   ${cor[1]}Sin conexiones activas${reset}"

        echo -e "${cor[2]}----------------------------------------------------${reset}"
        echo -e "${cor[1]}Factor: $factor • Actualiza cada ${refresh}s • Ctrl+C para salir${reset}"
        sleep $refresh
    done
}
