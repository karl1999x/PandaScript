    local today_seconds=$(date -d "$(date +%Y-%m-%d)" +%s)
    local base_date_str
    local dias_calculo=$dias_a_agregar

    # --- LÓGICA MEJORADA ---
    if (( exp_seconds <= today_seconds )); then
        # Usuario expirado: sumar desde hoy
        base_date_str=$(date +%Y-%m-%d)
        dias_calculo=$((dias_a_agregar + 1))
    else
        # Usuario activo: base de cálculo es la fecha actual de expiración
        base_date_str=$data_user_yyyymmdd
        dias_calculo=$dias_a_agregar
    fi

    local nueva_fecha_valida=$(date '+%Y-%m-%d' -d "$base_date_str + $dias_calculo days")
