    # Usar el HWID COMPLETO como nombre de usuario del sistema (soporta 32+ caracteres)
    local system_user="$hwid"

    if id -u "$system_user" &>/dev/null || grep -q "^${system_user}:" /etc/passwd 2>/dev/null; then
