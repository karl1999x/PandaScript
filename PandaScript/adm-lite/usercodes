    echo -e "\033[1;31m ⚠️ ¡No se registraron días! Regresando... ⚠️"
    return
  fi

  # Obtener la fecha de expiración actual en formato día/mes/año
  data_user=$(chage -l "$namer" | grep -i "Co" | awk -F ":" '{print $2}' | xargs)

  # Validar que se obtuvo la fecha de expiración correctamente
  if [ -z "$data_user" ]; then
    echo -e "\033[1;31m ⚠️ ¡No se pudo obtener la fecha de expiración! ⚠️"
    return
  fi

  # Convertir la fecha de expiración a formato YYYY-MM-DD
  data_user_yyyymmdd=$(date -d "$data_user" +%Y-%m-%d)

  # Calcular la fecha "Válido hasta" restando un día a la nueva fecha de expiración
  nueva_fecha_exp=$(date -d "$data_user_yyyymmdd -$dias_a_restar days" +%Y-%m-%d)

  # Calcular la fecha "Válido hasta" restando un día a la nueva fecha de expiración
  fecha_valido_hasta=$(date -d "$nueva_fecha_exp -1 day" "+%d/%m/%Y")

  # Obtener el límite de usuarios y establecerlo como 'null' si no existe
  limite=$(awk '/limite/ {print $2}' "$dir_user/$namer")
  [ -z "$limite" ] && limite="null"

  # Desbloquear usuario si está bloqueado
  if [[ $(passwd --status $namer | cut -d ' ' -f2) = "L" ]]; then
    usermod -U "$namer"
    echo -e "\033[1;32m ⚠️ Usuario desbloqueado ⚠️"
  fi

  # Actualizar la fecha de expiración en el sistema y en el archivo de usuario
  chage -E "$nueva_fecha_exp" "$namer" 2>/dev/null
  echo -e "$(awk '/^data/ {next} 1' "$dir_user/$namer")" > "$dir_user/$namer"
  echo -e "data: $nueva_fecha_exp" >> "$dir_user/$namer"

  # Calcular los días restantes
  dias_restantes=$(( ($(date -d "$nueva_fecha_exp" +%s) - $(date -d "$(date +%Y-%m-%d)" +%s)) / 86400 - 1 ))
  [ "$dias_restantes" -lt 0 ] && dias_restantes=0
 msg -bar
  # Mostrar mensaje de confirmación con detalles
  echo -e "\033[1;32m ✔️ ¡Membresía ajustada exitosamente! ✔️ "
  echo -e "\033[1;33m Días restados: \033[1;31m-$dias_a_restar días"
  echo -e "\033[1;34m Fecha de renovación: \033[1;32m$(date "+%d/%m/%Y")"
  echo -e "\033[1;34m Cliente: \033[1;36m$select_name" 
  echo -e "\033[1;34m Límite de usuarios: \033[1;36m$limite"

  # Mostrar la fecha de expiración final con el día restado
  echo -e "\033[1;34m Válido hasta: \033[1;32m$fecha_valido_hasta"
  echo -e "${cor[5]} Quedan $dias_restantes días. ¡Disfrute su estancia!"
  msg -bar
  pkill -u "$namer"
}






