function_5() {
    clear
    
    # ====================== CONSUMO CELULAR ======================
    local factor=1.85          # ← Cambia aquí si quieres ajustar

    get_consumo() {
        local user="$1"
        local total_bytes=0
        while read -r pid; do
            [[ -r "/proc/$pid/io" ]] || continue
            r=$(awk '/rchar:/{print $2}' "/proc/$pid/io" 2>/dev/null || echo 0)
            w=$(awk '/wchar:/{print $2}' "/proc/$pid/io" 2>/dev/null || echo 0)
            total_bytes=$((total_bytes + r + w))
        done < <(ps -u "$user" -o pid=,comm= 2>/dev/null | grep '[s]shd' | awk '{print $1}')

        local estimated=$(awk -v t="$total_bytes" -v f="$factor" 'BEGIN {printf "%d", t / f}')

        if (( estimated >= 1073741824 )); then
            awk -v b=$estimated 'BEGIN {printf "%.2fG", b/1073741824}'
        elif (( estimated >= 1048576 )); then
            awk -v b=$estimated 'BEGIN {printf "%.1fM", b/1048576}'
        else
            awk -v b=$estimated 'BEGIN {printf "%dK", b/1024}'
        fi
    }
    # ============================================================

    # Encabezado
    msg -bar
    echo -e "\E[41;1;37m         MONITOR DE USUARIOS + CONSUMO                 \E[0m"
    msg -bar
    echo -e "\033[1;36m   USUARIO               CONEX     CONSUMO      TIEMPO  \033[0m"
    msg -bar

    _data_now=$(date +%s)
    [[ -z $(locale | grep "LANG=" | cut -d "=" -f2) ]] && export LANG=en_US.UTF-8
    nU=1
    unset conex1

    journalctl -u dropbear --no-pager --since "1 day ago" 2>/dev/null | grep "Password auth succeeded" > /tmp/dropbear_logins.log
    ps -eo pid=,lstart=,comm= | grep 'dropbear' > /tmp/active_dropbear.log

    for user in `cat "/etc/passwd"|grep 'home'|grep 'false'|grep -v 'syslog' | cut -d: -f1 |sort -f`; do
       
        uid=$(id -u "$user" 2>/dev/null)
        [[ -n "$uid" ]] || continue

        sqd=0; drop=0; timerr="00:00:00"; _oldest_time_s=9999999999

        [[ -e /etc/openvpn/openvpn-status.log ]] && ovp="$(cat /etc/openvpn/openvpn-status.log | grep -E ,"$user", | wc -l)" || ovp=0

        # SSHD + Dropbear + OpenVPN (tu código original intacto)
        while read -r _pid _ppid; do
            [[ -z "$_pid" || -z "$_ppid" ]] && continue
            _pname=$(ps -p "$_ppid" -o comm= 2>/dev/null)
            if [[ "$_pname" == *"sshd"* ]]; then
                let sqd++
                _lstart_str=$(ps -p "$_pid" -o lstart= 2>/dev/null)
                [[ -n "$_lstart_str" ]] && _login_time_s=$(date -d "$_lstart_str" +%s 2>/dev/null)
                [[ -n "$_login_time_s" && "$_login_time_s" -lt "$_oldest_time_s" ]] && _oldest_time_s=$_login_time_s
            fi
        done < <(ps -u "$uid" --no-headers -o pid=,ppid= 2>/dev/null | grep -v "ps -u")

        grep "for '$user'" /tmp/dropbear_logins.log > /tmp/user_logins.log
        while read -r log_line; do
            _pid=$(echo "$log_line" | grep -o '\[[0-9]*\]' | tr -d '[]' | head -n 1)
            [[ -z "$_pid" ]] && continue
            _lstart_str_full=$(grep "^ *$_pid" /tmp/active_dropbear.log | awk '{$1=$NF=""; print $0}' | xargs)
            if [[ -n "$_lstart_str_full" ]]; then
                let drop++
                _login_time_s=$(date -d "$_lstart_str_full" +%s 2>/dev/null)
                [[ -n "$_login_time_s" && "$_login_time_s" -lt "$_oldest_time_s" ]] && _oldest_time_s=$_login_time_s
            fi
        done < /tmp/user_logins.log

        if [[ $ovp -gt 0 ]]; then
            _login_time_s_ovpn=$(grep -w "$user" /etc/openvpn/openvpn-status.log | head -n 1 | awk -F',' '{print $8}' 2>/dev/null)
            [[ -n "$_login_time_s_ovpn" && "$_login_time_s_ovpn" -lt "$_oldest_time_s" ]] && _oldest_time_s=$_login_time_s_ovpn
        fi

        if [[ "$_oldest_time_s" -lt 9999999999 ]]; then
            seg=$(($_data_now - $_oldest_time_s))
            min=$(($seg/60)); seg=$(($seg-$min*60))
            hor=$(($min/60)); min=$(($min-$hor*60))
            timerr=$(printf "%02d:%02d:%02d" $hor $min $seg)
        fi

        cnx=$(($sqd + $drop))
        conex=$(($cnx + $ovp))

        # ====================== IMPRESIÓN CON SEPARADOR ======================
        if [ "$conex" -gt "0" ]; then
            local consumo=$(get_consumo "$user")

            # Nombre limpio (con [HWID]/[TOKEN])
            local nombre_display="$user"
            if [[ -e $dir_user/${user} ]]; then
                local tipo=$(cat $dir_user/${user} | grep "limite" | awk '{print $2}')
                if [[ "$tipo" = "HWID" ]]; then
                    nombre_display="$(cat $dir_user/${user} | grep "senha" | awk '{print $2}') \033[1;34m[HWID]\033[0m"
                elif [[ "$tipo" = "TOKEN" ]]; then
                    nombre_display="$(cat $dir_user/${user} | grep "senha" | awk '{print $2}') \033[1;35m[TOKEN]\033[0m"
                fi
            fi
            

            # Línea 1
                        # Línea 1 - Ahora [HWID] sale en AZUL
            echo -e "\033[0;35m[${nU}]\033[0;37m ${nombre_display} \033[1;33m[${conex}/1]\033[0m"

            # Línea 2
            echo -e "   └─ \033[1;32mConsumo:\033[0m ${consumo}   \033[1;36mTiempo:\033[0m ${timerr}"

            # SEPARADOR ENTRE USUARIOS (guiones)
            echo -e "\033[0;90m─────────────────────────────────────────────────────\033[0m\n"

            conex1+="${conex}+"
            let nU++
        fi
    done

    rm -f /tmp/dropbear_logins.log /tmp/active_dropbear.log /tmp/user_logins.log &>/dev/null
    conex1+="0"
    conex1=$(echo $conex1|bc)

