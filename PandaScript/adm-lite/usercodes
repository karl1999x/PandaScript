ver_consumo_detallado() {
    clear
    local CONSUMO_FILE="/root/consumo_acumulado.dat"
    local FACTOR=1.85

    local start_time=$(stat -c %W "$CONSUMO_FILE" 2>/dev/null || stat -c %Y "$CONSUMO_FILE")
    local days=$(( ( $(date +%s) - start_time ) / 86400 ))
    [[ $days -eq 0 ]] && days=1

    msg -bar
    echo -e "\E[41;1;37m     CONSUMO DETALLADO DE TODOS LOS USUARIOS (FACTOR 1.85)     \E[0m"
    msg -bar
    echo -e "\033[1;36m   USUARIO                              CONSUMO       DÍAS ACUM.\033[0m"
    msg -bar

    local pos=1
    while IFS=: read -r usuario bytes; do
        [[ -z "$usuario" || -z "$bytes" ]] && continue

        local clean_user="${usuario%+}"

        local estimated=$(awk -v b=$bytes -v f=$FACTOR 'BEGIN {printf "%.0f", b / f}')

        local consumo
        if (( estimated >= 1073741824 )); then
            consumo=$(awk -v b=$estimated 'BEGIN {printf "%.2f GB", b/1073741824}')
        elif (( estimated >= 1048576 )); then
            consumo=$(awk -v b=$estimated 'BEGIN {printf "%.1f MB", b/1048576}')
        else
            consumo=$(awk -v b=$estimated 'BEGIN {printf "%d KB", b/1024}')
        fi

        local nombre_display="$clean_user"
        local dir_real=$(find /etc/adm-lite/userDIR -name "${clean_user}*" -type f 2>/dev/null | head -n1)
        if [[ -n "$dir_real" ]]; then
            local tipo=$(grep "limite" "$dir_real" 2>/dev/null | awk '{print $2}')
            if [[ "$tipo" = "HWID" || "$tipo" = "TOKEN" ]]; then
                nombre_display="$(grep "senha" "$dir_real" 2>/dev/null | awk '{print $2}')"
                [[ "$tipo" = "HWID" ]] && nombre_display="${nombre_display} \033[1;34m[HWID]\033[0m"
                [[ "$tipo" = "TOKEN" ]] && nombre_display="${nombre_display} \033[1;35m[TOKEN]\033[0m"
            fi
        fi

        echo -e "\033[0;35m[${pos}]\033[0;37m ${nombre_display} \033[1;33m[1/1]\033[0m"
        echo -e "   └─ \033[1;32mConsumo:\033[0m ${consumo}   \033[1;36mDías acumulados:\033[0m ${days}"
        echo -e "\033[0;90m────────────────────────────────────────────────────────────\033[0m\n"

        ((pos++))
    done < <(sort -t: -k2 -nr "$CONSUMO_FILE")

    msg -bar
    echo -e "\033[1;33mTOTAL ACUMULADO (todos los usuarios): \033[1;32m$(awk '{sum+=$2} END {printf "%.2f GB", sum/1073741824}' "$CONSUMO_FILE")\033[0m"
    msg -bar
    echo -e "\033[1;37mPresiona Enter para volver...\033[0m"
    read -r
}
