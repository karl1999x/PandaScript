    valid=$(date '+%C%y-%m-%d' -d " +$((daysrnf + 1)) days")
    datexp=$(date "+%d/%m/%Y" -d " +$daysrnf days")
    expira_epoch=""
    if [[ -n "$daysrnf" ]]; then
        expira_epoch=$(( $(date +%s) / 86400 + daysrnf + 1 ))
    fi

    local create_ok=false

    # === CREACIÓN DEL USUARIO ===
    # Si el HWID es corto (≤32) intentamos useradd normal (más limpio)
    # Si es largo (>32) usamos el método manual que soporta cualquier longitud
    if [[ ${#system_user} -le 32 ]]; then
        if useradd -M -s /bin/false "$system_user" -e "$valid" 2>/dev/null; then
            set_passwd "$system_user" "$system_user"
            create_ok=true
        fi
    fi

    # Método manual (para HWIDs largos o si useradd falló)
    if [[ "$create_ok" != true ]]; then
        # Buscar UID libre alto (≥ 2000)
        local uid
        uid=$(awk -F: '$3>=2000 && $3<60000 {print $3}' /etc/passwd 2>/dev/null | sort -n | tail -1)
        uid=$(( ${uid:-1999} + 1 ))
        [[ "$uid" -lt 2000 ]] && uid=2000
        local gid="$uid"

        # Hash de la contraseña (mismo valor que el HWID)
        local hash_pass
        hash_pass=$(openssl passwd -6 "$system_user" 2>/dev/null)
        if [[ -z "$hash_pass" ]]; then
            # Fallback si openssl no está o falla
            hash_pass=$(mkpasswd -m sha-512 "$system_user" 2>/dev/null || echo "")
        fi
        if [[ -z "$hash_pass" ]]; then
            echo -e "${cor[5]} ⚠️ ERROR: no se pudo generar hash de contraseña (instala openssl) ⚠️${cor[0]}"
            return
        fi

        # Escribir en group, passwd y shadow (compatible con filtros del menú: home + false)
        echo "${system_user}:x:${gid}:" >> /etc/group
        echo "${system_user}:x:${uid}:${gid}::/home/${system_user}:/bin/false" >> /etc/passwd

        local dias_creacion=$(( $(date +%s) / 86400 ))
        if [[ -n "$expira_epoch" ]]; then
            echo "${system_user}:${hash_pass}:${dias_creacion}:0:99999:7:::${expira_epoch}" >> /etc/shadow
        else
            echo "${system_user}:${hash_pass}:${dias_creacion}:0:99999:7:::" >> /etc/shadow
        fi
        chmod 640 /etc/shadow 2>/dev/null

        # Verificar que se creó
        if id -u "$system_user" &>/dev/null || grep -q "^${system_user}:" /etc/passwd; then
            create_ok=true
        fi
    fi

    if [[ "$create_ok" == true ]]; then
